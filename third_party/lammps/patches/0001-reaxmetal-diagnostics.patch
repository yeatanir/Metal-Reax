index 0000000000000000000000000000000000000000..0a3c94707a99af5587f4e8923c357813cddb8bed
--- /dev/null
+++ b/src/REAXFF/reaxff_diag.h
@@ -0,0 +1,122 @@
+// ReaxMetal diagnostics instrumentation for the REAXFF package.
+// Added by ReaxMetal patch 0001 (third_party/lammps/patches/). This file is NOT part of upstream LAMMPS.
+// SPDX-License-Identifier: GPL-2.0-only
+// SPDX-FileCopyrightText: 2026 Anirban Phukan
+//
+// Design contract (verified by tools/check_instrumented_equivalence.py):
+//   * Observation only. No physics variable is read-modified-written; every hook copies values out.
+//   * Fully inert unless the environment variable REAXMETAL_DIAG_DIR names an existing directory.
+//     With it unset, the only cost is one cached boolean test per hook.
+//   * Output is plain text, one file per Compute_Forces call, doubles printed with %.17g (lossless).
+#ifndef REAXMETAL_REAXFF_DIAG_H
+#define REAXMETAL_REAXFF_DIAG_H
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace ReaxMetalDiag {
+
+struct Tally {
+  long long count = 0;
+  double energy = 0.0;
+};
+
+struct State {
+  bool checked = false;
+  bool on = false;
+  std::string dir;
+  long call = 0;                                  // Compute_Forces call counter (0-based)
+  std::map<std::string, Tally> tallies;           // key "<term>.<class>"
+  std::vector<std::array<double, 3>> bo_prime;    // BO'(s, pi, pipi) per bond-list slot, snapshotted at BO() entry
+  std::vector<std::array<double, 3>> atom_e;      // per-owned-atom (e_lp, e_ov, e_un)
+  // QEq diagnostics for the most recent pre_force
+  struct Qeq {
+    bool valid = false;
+    int imax = 0;
+    double tolerance = 0.0;
+    int iters_s = 0, iters_t = 0;
+    double rel0_s = 0, rel0_t = 0, relf_s = 0, relf_t = 0;
+    int ncg = 0;
+  } qeq;
+};
+
+inline State &st()
+{
+  static State s;
+  if (!s.checked) {
+    s.checked = true;
+    const char *d = std::getenv("REAXMETAL_DIAG_DIR");
+    if (d && *d) {
+      s.on = true;
+      s.dir = d;
+    }
+  }
+  return s;
+}
+inline bool on() { return st().on; }
+
+// pair-class names: oo = owned-owned, og = owned-ghost, self = a bond/pair between an atom and its own periodic image
+inline const char *pair_class(int i, int j, long long tag_i, long long tag_j, int nowned)
+{
+  if (tag_i == tag_j) return "self";
+  return (i < nowned && j < nowned) ? "oo" : "og";
+}
+
+inline void tally(const char *term, const char *cls, double e)
+{
+  if (!on()) return;
+  Tally &t = st().tallies[std::string(term) + "." + cls];
+  t.count += 1;
+  t.energy += e;
+}
+// multi-body terms are classified by how many of their atoms are ghosts: g0 (all owned) ... g4
+inline void tally_ghosts(const char *term, int nghost, double e)
+{
+  if (!on()) return;
+  char buf[8];
+  std::snprintf(buf, sizeof buf, "g%d", nghost);
+  tally(term, buf, e);
+}
+
+inline void atom_energy(int i, int slot, double e)
+{
+  if (!on()) return;
+  State &s = st();
+  if ((int) s.atom_e.size() <= i) s.atom_e.resize(i + 1, {0.0, 0.0, 0.0});
+  s.atom_e[i][slot] += e;
+}
+
+// ---- QEq hooks (called from FixQEqReaxFF) --------------------------------------------------
+inline void qeq_begin(int imax, double tol)
+{
+  if (!on()) return;
+  State &s = st();
+  s.qeq = State::Qeq();
+  s.qeq.valid = true;
+  s.qeq.imax = imax;
+  s.qeq.tolerance = tol;
+}
+inline void qeq_cg(int iters, double rel0, double relf)
+{
+  if (!on()) return;
+  State::Qeq &q = st().qeq;
+  if (q.ncg == 0) { q.iters_s = iters; q.rel0_s = rel0; q.relf_s = relf; }
+  else            { q.iters_t = iters; q.rel0_t = rel0; q.relf_t = relf; }
+  ++q.ncg;
+}
+
+inline void reset_call()
+{
+  State &s = st();
+  s.tallies.clear();
+  s.bo_prime.clear();
+  s.atom_e.clear();
+}
+
+}    // namespace ReaxMetalDiag
+
+#endif
